{
  "version": "1",
  "comment": "Session 09. Compiler patches mutability here. grantDenylist tightens Verifier Display names so constructor twins cannot hold Operator write or rebuild ops.",
  "ops": {
    "accrual.tools.create_accrual": {
      "mutability": "write-local",
      "sodClass": "accrual-write",
      "ownerPrefixes": ["runs/accrual/"]
