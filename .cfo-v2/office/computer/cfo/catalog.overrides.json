      "evalOnly": true,
      "sodClass": "audit-eval"
    }
  },
  "grantDenylist": {
    "AP Reviewer": [
      "tools.get_invoice",
      "tools.get_purchase_order",
      "tools.get_goods_receipt",
      "tools.find_duplicate_invoices",
      "accrual.tools.create_accrual",
      "accrual.tools.reconcile_accrual_with_invoice",
      "scheduling.tools.get_payment_candidates",
      "scheduling.tools.get_approved_pool"
    ],
    "AP Approver": [
      "tools.get_invoice",
      "tools.get_purchase_order",
      "tools.get_goods_receipt",
      "tools.find_duplicate_invoices",
      "accrual.tools.create_accrual",
      "scheduling.tools.get_payment_candidates"
    ],
    "AP Audit": [
      "tools.get_invoice",
      "tools.get_purchase_order",
      "tools.get_goods_receipt",
      "tools.find_duplicate_invoices",
      "tools.get_prior_cases",
      "accrual.tools.create_accrual"
    ],
    "Payment Audit": [
      "scheduling.tools.get_payment_candidates",
      "scheduling.tools.get_approved_pool",
      "tools.get_invoice",
      "accrual.tools.create_accrual"
    ],
    "Cash Application Reviewer": [
      "accrual.tools.create_accrual",
      "tools.get_invoice",
      "scheduling.tools.get_payment_candidates"
    ],
    "Cash Reconciliation Reviewer": [
      "accrual.tools.create_accrual",
      "tools.get_invoice"
    ],
    "Prepaid Reviewer": [
      "accrual.tools.create_accrual",
      "accrual.tools.reconcile_accrual_with_invoice"
    ],
    "Fixed Asset Reviewer": [
      "accrual.tools.create_accrual"
