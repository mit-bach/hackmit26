{
  "name": "harness-v3",
  "version": "3.0.0",
  "description": "Named Bots, durable Handles, and a shared Computer. Pi is the per-Bot turn engine.",
  "type": "module",
  "keywords": [
    "pi-package",
    "harness",
    "multi-agent"
  ],
  "license": "MIT",
  "bin": {
    "harness": "./bin/harness.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "src",
    "extensions",
    "skills",
    "examples",
    "ui/dist",
    "ui/NOTICE",
    ".pi"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test dist/tests/*.test.js",
    "ui:install": "npm --prefix ui install",
    "ui:build": "npm --prefix ui run build",
    "ui:dev": "npm --prefix ui run dev",
    "serve": "npm run build && npm --prefix ui install && npm --prefix ui run build && node dist/src/cli.js serve",
    "prepare": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@types/node": "^24.5.2",
    "typebox": "^1.3.7",
    "typescript": "^5.9.2"
  }
}
